# ==============================================================================
# Next.js App Environment Configuration Template
# Duplicate this file to .env.local and populate the values for local development.
# ==============================================================================

# Node.js Environment (development | test | production)
NODE_ENV=development

# Backend API Endpoint (External Express, NestJS, Fastify backend)
API_BASE_URL=http://localhost:4000

# Server Secret Key (Never expose to client or prefix with NEXT_PUBLIC_)
API_SECRET_KEY=super_secret_key_change_in_prod

# ------------------------------------------------------------------------------
# Public Client Variables (Exposed to the browser)
# ------------------------------------------------------------------------------

# Application Display Name
NEXT_PUBLIC_APP_NAME="N2 Football Academy"

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Analytics Toggle (true | false)
NEXT_PUBLIC_ENABLE_ANALYTICS=false
